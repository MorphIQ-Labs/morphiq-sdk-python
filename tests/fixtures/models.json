    {
      "id": "black_scholes_merton_qdfp",
      "name": "American Black\u2013Scholes\u2013Merton \u2014 QdFp",
      "version": "1",
      "model_version": "qd_fixed_point/1",
      "underlying_model": "black_scholes_merton",
      "method": "qd_fixed_point",
      "exercise_styles": [
        "american"
      ],
      "dividend_support": [
        "continuous_yield"
      ],
      "operations": [
        "options.price",
        "options.implied_volatility"
      ],
      "greeks": [],
      "guidance": "American calls and puts with a continuous dividend yield.",
      "constraints": [],
      "validity": [
        {
          "quantity": "price",
          "status": "validated",
          "criterion": "strict",
          "tolerance": {
            "relative": 0.0,
            "absolute": 0.0001,
            "absolute_unit": "max(spot, strike)"
          },
          "region": [
            {
              "kind": "interval",
              "input": "volatility * sqrt(time_to_expiry_years)",
              "minimum": 4e-05,
              "maximum": 3.0
            },
            {
              "kind": "condition",
              "name": "diffusion-to-carry face",
              "formula": "sigma sqrt(T) >= 0.0139 |r - q| T (put coordinates)"
            },
            {
              "kind": "condition",
              "name": "FP-A face",
              "formula": "sigma sqrt(T) >= (r - q) T where QuantLib's scheme iterates FP-A and r > q (put coordinates)"
            },
            {
              "kind": "interval",
              "input": "put-coordinate rate * time_to_expiry_years",
              "maximum": 3.0
            },
            {
              "kind": "interval",
              "input": "put-coordinate yield * time_to_expiry_years",
              "minimum": -1.0,
              "maximum": 3.0
            }
          ],
          "outside": "unsupported_accuracy_contract"
        },
        {
          "quantity": "implied_volatility",
          "status": "validated",
          "criterion": "inverse_of_price",
          "region": [
            {
              "kind": "interval",
              "input": "volatility * sqrt(time_to_expiry_years)",
              "minimum": 4e-05,
              "maximum": 3.0
            },
            {
              "kind": "condition",
              "name": "diffusion-to-carry face",
              "formula": "sigma sqrt(T) >= 0.0139 |r - q| T (put coordinates)"
            },
            {
              "kind": "condition",
              "name": "FP-A face",
              "formula": "sigma sqrt(T) >= (r - q) T where QuantLib's scheme iterates FP-A and r > q (put coordinates)"
            },
            {
              "kind": "interval",
              "input": "put-coordinate rate * time_to_expiry_years",
              "maximum": 3.0
            },
            {
              "kind": "interval",
              "input": "put-coordinate yield * time_to_expiry_years",
              "minimum": -1.0,
              "maximum": 3.0
            }
          ],
          "outside": "unsupported_accuracy_contract"
        }
      ],
      "notes": "The pinned Risk engine uses optimized fixed-work pricing with absolute error at most 1e-4 * max(spot, strike) against the independent American value, including reference uncertainty. The API accepts options.price and options.implied_volatility only. Greeks, batch, scenario and book operations return HTTP 422 unsupported_operation for explicit QdFp selection. Engine derivative implementations are retained but not exposed. IV inverts the served price; its residual is not an exact-American volatility error bound. Numerical values and inverse availability change from v0.42.x despite the unchanged model_version. Engine domains and per-input refusals remain authoritative."
    },
